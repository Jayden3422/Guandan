<!-- 掼蛋 Guandan - Global UI -->
<!-- One column of buttons in the lower right corner, from top to bottom: -->
<!-- 正序 / 倒序, 竖摞, 选牌 / 出牌, 收回, 理牌 -->

<!-- "正序" and "倒序" share one spot: the script shows each player the one that says which way their hand is sorted next. -->
<Button
    id="guandanSortButton"
    onClick="onSortButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 288"
    width="150"
    height="46"
    fontSize="22"
    colors="#00695C|#00796B|#004D40|#555555"
    textColor="#FFFFFF"
    tooltip="把手牌从小到大排成一排；之后这个按钮变成“倒序”（小键盘 1）"
    tooltipPosition="Left">正序</Button>
<Button
    id="guandanSortDescendingButton"
    active="false"
    onClick="onSortButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 288"
    width="150"
    height="46"
    fontSize="22"
    colors="#00695C|#00796B|#004D40|#555555"
    textColor="#FFFFFF"
    tooltip="把手牌从大到小排成一排；之后这个按钮变回“正序”（小键盘 1）"
    tooltipPosition="Left">倒序</Button>
<Button
    id="guandanStackButton"
    onClick="onStackButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 234"
    width="150"
    height="46"
    fontSize="22"
    colors="#00695C|#00796B|#004D40|#555555"
    textColor="#FFFFFF"
    tooltip="竖摞：同点数的牌摞成一列；点“正序 / 倒序”恢复成一排（小键盘 4）"
    tooltipPosition="Left">竖摞</Button>

<!-- "选牌" and "出牌" share one spot: the script shows "出牌" to the players who are picking cards, "选牌" to the others. -->
<Button
    id="guandanPickButton"
    onClick="onPickButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 170"
    width="150"
    height="56"
    fontSize="26"
    fontStyle="Bold"
    colors="#1565C0|#1976D2|#0D47A1|#555555"
    textColor="#FFFFFF"
    tooltip="开始选牌：点手牌放进出牌区，点出牌区里的牌放回手牌（小键盘 2）"
    tooltipPosition="Left">选牌</Button>
<Button
    id="guandanPlayButton"
    active="false"
    onClick="onPlayButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 170"
    width="150"
    height="56"
    fontSize="26"
    fontStyle="Bold"
    colors="#2E7D32|#388E3C|#1B5E20|#555555"
    textColor="#FFFFFF"
    tooltip="打出出牌区里的所有牌（小键盘 2）"
    tooltipPosition="Left">出牌</Button>
<Button
    id="guandanReturnButton"
    onClick="onReturnButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 116"
    width="150"
    height="46"
    fontSize="22"
    colors="#455A64|#546E7A|#37474F|#555555"
    textColor="#FFFFFF"
    tooltip="把出牌区里的牌全部收回手牌，并结束选牌（小键盘 3）"
    tooltipPosition="Left">收回</Button>
<Button
    id="guandanGroupButton"
    onClick="onGroupButtonClick"
    rectAlignment="LowerRight"
    offsetXY="-20 62"
    width="150"
    height="46"
    fontSize="22"
    colors="#6A1B9A|#7B1FA2|#4A148C|#555555"
    textColor="#FFFFFF"
    tooltip="把出牌区里的牌理成一组，单独摞在手牌左边；点组里任意一张，整组回到出牌区（小键盘 5）"
    tooltipPosition="Left">理牌</Button>
